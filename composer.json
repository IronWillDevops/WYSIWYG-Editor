{
    "name": "wysiwyg/laravel-editor",
    "description": "WYSIWYG Editor — a modern, dependency-free WYSIWYG HTML editor for Laravel, built with native JavaScript (ES6+), HTML5 and CSS3.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "editor",
        "wysiwyg",
        "html-editor",
        "rich-text",
        "blade",
        "livewire",
        "alpine",
        "tailwind",
        "bootstrap"
    ],
    "homepage": "https://github.com/wysiwyg/laravel-editor",
    "authors": [
        {
            "name": "WYSIWYG Editor Contributors",
            "homepage": "https://github.com/wysiwyg/laravel-editor/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0 || ^14.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0 || ^14.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0 || ^14.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "laravel/pint": "^1.17"
    },
    "autoload": {
        "psr-4": {
            "Wysiwyg\\Editor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wysiwyg\\Editor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wysiwyg\\Editor\\WysiwygEditorServiceProvider"
            ],
            "aliases": {
                "WysiwygEditor": "Wysiwyg\\Editor\\Facades\\WysiwygEditor"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
