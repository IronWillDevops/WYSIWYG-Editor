{
    "name": "wysiwyg/laravel-editor-demo",
    "description": "Minimal Laravel demo application for WYSIWYG Editor.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "wysiwyg/laravel-editor": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": { "symlink": true }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "app/" }
    }
}
